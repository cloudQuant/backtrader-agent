{
  "task_id": "inject-bad-data",
  "intent": "inspect a DataSpec whose column mapping violates the OHLC relationship, assert BTAG-DATA-OHLC, then fix the mapping and re-inspect per the recovery table",
  "fixture": [
    {
      "generator": "write_price_csv",
      "path": "prices.csv",
      "kwargs": {
        "rows": 40
      }
    }
  ],
  "steps": [
    {
      "argv": [
        "roots",
        "register",
        "--id",
        "input",
        "--path",
        "{state_root}",
        "--kind",
        "dataset"
      ],
      "expect": {
        "exit_code": 0,
        "envelope": "ok",
        "json_path_eq": {
          "result.root_id": "input",
          "result.kind": "dataset"
        }
      }
    },
    {
      "argv": [
        "session",
        "create",
        "--session-id",
        "sess-001"
      ],
      "expect": {
        "exit_code": 0,
        "envelope": "ok",
        "json_path_eq": {
          "result.state": "NEW",
          "result.session_id": "sess-001"
        }
      }
    },
    {
      "argv": [
        "data",
        "inspect",
        "--spec",
        "{\"schema_version\":\"dataset-manifest-v1\",\"name\":\"demo-prices\",\"feeds\":[{\"feed_id\":\"primary\",\"name\":\"primary\",\"role\":\"execution\",\"root_id\":\"input\",\"relative_path\":\"prices.csv\",\"format\":\"generic_csv\",\"datetime_format\":\"%Y-%m-%d\",\"timeframe\":\"Days\",\"compression\":1,\"timezone\":\"UTC\",\"bar_semantics\":\"close\",\"columns\":{\"datetime\":\"date\",\"open\":\"open\",\"high\":\"low\",\"low\":\"low\",\"close\":\"close\",\"volume\":\"volume\",\"openinterest\":\"openinterest\"}}],\"alignment\":{\"mode\":\"intersection\",\"minimum_overlap\":1}}"
      ],
      "expect": {
        "exit_code": 3,
        "envelope": "failed",
        "json_path_eq": {
          "diagnostic.code": "BTAG-DATA-OHLC"
        }
      }
    },
    {
      "argv": [
        "data",
        "inspect",
        "--spec",
        "{\"schema_version\":\"dataset-manifest-v1\",\"name\":\"demo-prices\",\"feeds\":[{\"feed_id\":\"primary\",\"name\":\"primary\",\"role\":\"execution\",\"root_id\":\"input\",\"relative_path\":\"prices.csv\",\"format\":\"generic_csv\",\"datetime_format\":\"%Y-%m-%d\",\"timeframe\":\"Days\",\"compression\":1,\"timezone\":\"UTC\",\"bar_semantics\":\"close\",\"columns\":{\"datetime\":\"date\",\"open\":\"open\",\"high\":\"high\",\"low\":\"low\",\"close\":\"close\",\"volume\":\"volume\",\"openinterest\":\"openinterest\"}}],\"alignment\":{\"mode\":\"intersection\",\"minimum_overlap\":1}}"
      ],
      "expect": {
        "exit_code": 0,
        "envelope": "ok",
        "json_path_eq": {
          "result.status": "valid",
          "result.master_feed": "primary"
        }
      }
    },
    {
      "argv": [
        "data",
        "register",
        "--spec",
        "{\"schema_version\":\"dataset-manifest-v1\",\"name\":\"demo-prices\",\"feeds\":[{\"feed_id\":\"primary\",\"name\":\"primary\",\"role\":\"execution\",\"root_id\":\"input\",\"relative_path\":\"prices.csv\",\"format\":\"generic_csv\",\"datetime_format\":\"%Y-%m-%d\",\"timeframe\":\"Days\",\"compression\":1,\"timezone\":\"UTC\",\"bar_semantics\":\"close\",\"columns\":{\"datetime\":\"date\",\"open\":\"open\",\"high\":\"high\",\"low\":\"low\",\"close\":\"close\",\"volume\":\"volume\",\"openinterest\":\"openinterest\"}}],\"alignment\":{\"mode\":\"intersection\",\"minimum_overlap\":1}}",
        "--session-id",
        "sess-001"
      ],
      "expect": {
        "exit_code": 0,
        "envelope": "ok",
        "json_path_eq": {
          "result.status": "valid",
          "result.master_feed": "primary"
        }
      }
    },
    {
      "argv": [
        "data",
        "list"
      ],
      "expect": {
        "exit_code": 0,
        "envelope": "ok",
        "json_path_eq": {
          "result.datasets.0.dataset_id": "{steps.4.result.dataset_id}",
          "result.datasets.0.status": "valid"
        }
      }
    }
  ]
}
